{
  "id": "doramasyt",
  "name": "DoramasYT",
  "version": "0.6.7",
  "apiVersion": 30,
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Doramas asiáticos en español (latino, castellano o subtitulados) de doramasyt.com: sección propia, géneros, en emisión, películas y búsqueda.",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-doramasyt",
  "hosts": [
    "raw.githubusercontent.com",
    "doramasyt.com",
    "www.doramasyt.com",
    "mp4upload.com",
    "www.mp4upload.com",
    "luluvdo.com",
    "lulustream.com",
    "mxdrop.click",
    "mixdrop.top",
    "mixdrop.to",
    "mixdrop.co",
    "mixdrop.ag",
    "mixdrop.ch",
    "mixdrop.ps",
    "mixdrop.sx",
    "mixdrop.bz",
    "mxdrop.to",
    "streamtape.com",
    "streamtape.to",
    "streamtape.net",
    "streamta.pe",
    "strtape.cloud",
    "strcloud.link",
    "stape.fun",
    "streamadblocker.xyz"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download",
    "screen"
  ],
  "streamHosts": "any",
  "browser": true,
  "categories": [
    "series",
    "movies"
  ],
  "color": "#7C3AED",
  "section": {
    "label": "Doramas",
    "labelEn": "Dramas"
  },
  "theme": {
    "accent": "#7C3AED",
    "onAccent": "#FFFFFF",
    "background": "#0F0A1E",
    "surface": "#1B1430",
    "highlight": "#C4B5FD"
  },
  "settings": [
    {
      "key": "audioSection",
      "type": "section",
      "label": "Idioma",
      "labelEn": "Language",
      "hint": "Elige qué doramas salen en las listas, las categorías y la búsqueda.",
      "hintEn": "Choose which dramas show in lists, categories and search."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Mostrar",
      "labelEn": "Show",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "Todos",
          "labelEn": "All"
        },
        {
          "value": "dub",
          "label": "Solo doblados (latino o castellano)",
          "labelEn": "Dubbed only (Latino or Castilian)"
        },
        {
          "value": "sub",
          "label": "Solo subtitulados",
          "labelEn": "Subtitled only"
        }
      ]
    },
    {
      "key": "coversSection",
      "type": "section",
      "label": "Carátulas",
      "labelEn": "Covers",
      "hint": "El sitio bloquea sus imágenes para Kino; las carátulas salen de TMDB, por título.",
      "hintEn": "The site blocks its images for Kino; covers come from TMDB, by title."
    },
    {
      "key": "covers",
      "type": "toggle",
      "label": "Carátulas de TMDB",
      "labelEn": "TMDB covers",
      "default": true,
      "hint": "Apágalas para no pedir nada a TMDB.",
      "hintEn": "Turn off to ask TMDB for nothing."
    },
    {
      "key": "info",
      "type": "status",
      "label": "Estado",
      "labelEn": "Status"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Vaciar caché",
      "labelEn": "Clear cache",
      "confirm": "¿Vaciar la caché de listas y carátulas?",
      "confirmEn": "Clear the list and cover cache?"
    }
  ],
  "telemetry": true,
  "screen": {
    "label": "DoramasYT",
    "labelEn": "DoramasYT",
    "icon": "movie",
    "menuOpens": "screen",
    "opensFrom": [
      "menu",
      "settings"
    ],
    "settingsButton": {
      "label": "Abrir DoramasYT",
      "labelEn": "Open DoramasYT"
    },
    "settingsIn": "both"
  },
  "consumes": {
    "resolver": {
      "repo": "xuper-plugin/kino-plugin-kino-resolver",
      "door": "resolver",
      "calls": [
        "resolve"
      ]
    }
  },
  "recommends": [
    "xuper-plugin/kino-plugin-kino-resolver"
  ],
  "provides": {
    "catalog": {
      "summary": "Titles this plugin finds, for the author's other plugins",
      "calls": {
        "search": {
          "in": {
            "q": "string",
            "type": "string?"
          },
          "out": "Item[]"
        }
      },
      "types": {
        "Item": {
          "id": "string",
          "ref": "string",
          "title": "string",
          "kind": "string",
          "poster": "string?",
          "backdrop": "string?",
          "year": "string?",
          "overview": "string?",
          "tmdb": "number?"
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "aa8ec1b9bdbcde12f838ced026139607680a7355cf71704d0a478670bcefb266d53cac955335360b3d527bcdcb8cff67a6718bc23eb8e7dce2f0b8b7c75f8a09"
  }
}
